<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Base" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/win_bg_light</item>
        <item name="android:statusBarColor">@color/win_bg_light</item>
        <item name="android:navigationBarColor">@color/win_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#2E7BFF</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="AppTheme.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/win_bg_dark</item>
        <item name="android:statusBarColor">@color/win_bg_dark</item>
        <item name="android:navigationBarColor">@color/win_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#4C8DFF</item>
    </style>
</resources>
